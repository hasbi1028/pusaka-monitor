package templates

templ ScrapePage() {
	@Layout("Scrape", "", "") {
		@Sidebar("scrape")
		<div class="main-content">
			@Topbar("Scrape")
			<div class="content">
				<!-- Action Button -->
				<div class="card mb-2">
					<div class="card-body py-2">
						<button class="btn btn-success w-100 mb-2" onclick="createJobs('all')">
							<i class="bi bi-lightning-charge-fill"></i> Scrape Semua (Belum Lengkap)
						</button>
						<div class="d-flex gap-2">
							<button class="btn btn-outline-secondary btn-sm flex-fill" onclick="createJobs('belum_masuk')">
								<i class="bi bi-clock-history"></i> Belum Masuk
							</button>
							<button class="btn btn-outline-info btn-sm flex-fill" onclick="createJobs('belum_pulang')">
								<i class="bi bi-clock"></i> Belum Pulang
							</button>
						</div>
					</div>
				</div>
				<!-- Stats -->
				<div class="row g-2 mb-2">
					<div class="col-6 col-lg-3">
						<div class="stat-card total">
							<div class="number" id="pending">0</div>
							<div class="label">Pending</div>
						</div>
					</div>
					<div class="col-6 col-lg-3">
						<div class="stat-card" style="border-color:#0d6efd;">
							<div class="number text-primary" id="running">0</div>
							<div class="label">Running</div>
						</div>
					</div>
					<div class="col-6 col-lg-3">
						<div class="stat-card hadir">
							<div class="number text-success" id="done">0</div>
							<div class="label">Selesai</div>
						</div>
					</div>
					<div class="col-6 col-lg-3">
						<div class="stat-card alfa">
							<div class="number text-danger" id="failed">0</div>
							<div class="label">Gagal</div>
						</div>
					</div>
				</div>
				<!-- Retry + Cancel All -->
				<div class="d-flex gap-2 mb-2">
					<button class="btn btn-outline-warning btn-sm flex-fill" onclick="retryFailed()">
						<i class="bi bi-arrow-repeat"></i> Retry Gagal
					</button>
					<button class="btn btn-outline-danger btn-sm flex-fill" onclick="cancelAll()">
						<i class="bi bi-x-circle"></i> Cancel All
					</button>
				</div>
				<!-- Jobs Table -->
				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<span><i class="bi bi-list-check"></i> Antrian Job</span>
						<span class="badge bg-primary" id="jobCount">0</span>
					</div>
					<div class="card-body py-2">
						<div class="d-flex gap-2 mb-2">
							<input type="text" class="form-control form-control-sm" id="jobSearch" placeholder="Cari nama..." oninput="applyJobFilter()">
							<select class="form-select form-select-sm" style="width:auto;" id="jobStatusFilter" onchange="applyJobFilter()">
								<option value="">Semua</option>
								<option value="pending">Pending</option>
								<option value="running">Running</option>
								<option value="done">Selesai</option>
								<option value="failed">Gagal</option>
								<option value="cancelled">Dibatalkan</option>
							</select>
						</div>
					</div>
					<div class="table-responsive" style="max-height:50vh; overflow-y:auto;">
						<table class="table table-hover">
							<thead>
								<tr><th>Nama</th><th>Status</th><th>Waktu</th><th>Error</th><th></th></tr>
							</thead>
							<tbody id="jobsTable">
								<tr><td colspan="5" class="text-center text-muted py-4">Belum ada job</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		@BottomNav("scrape")
		<script>
			async function loadStatus() {
				const res = await fetch('/api/scrape/status');
				const data = await res.json();
				if (data.success) {
					document.getElementById('pending').textContent = data.data.stats.pending || 0;
					document.getElementById('running').textContent = data.data.stats.running || 0;
					document.getElementById('done').textContent = data.data.stats.done || 0;
					document.getElementById('failed').textContent = data.data.stats.failed || 0;
					document.getElementById('jobCount').textContent = data.data.jobs.length;
					allJobs = data.data.jobs; // simpan untuk filter
					applyJobFilter();
				}
			}

			let allJobs = [];
			function applyJobFilter() {
				const q = (document.getElementById('jobSearch').value || '').toLowerCase();
				const sf = document.getElementById('jobStatusFilter').value;
				const tbody = document.getElementById('jobsTable');
				const filtered = allJobs.filter(j =>
					(!q || (j.employee_name || '').toLowerCase().includes(q)) &&
					(!sf || j.status === sf)
				);
				if (filtered.length === 0) {
					tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Tidak ada job</td></tr>';
					return;
				}
				tbody.innerHTML = filtered.map(j => {
					const cancellable = (j.status === 'pending' || j.status === 'running');
					const btn = cancellable
						? `<button class="btn btn-sm btn-outline-danger" onclick="cancelOne('${j.id}')"><i class="bi bi-x"></i></button>`
						: '';
					const created = j.created_at ? new Date(j.created_at).toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '-';
					const completed = j.completed_at ? new Date(j.completed_at).toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '';
					const waktu = completed ? `${created}<br><small class="text-success">✓ ${completed}</small>` : `<span class="text-warning">${created}</span>`;
					return `
						<tr>
							<td>${j.employee_name}</td>
							<td><span class="badge ${j.status==='done'?'bg-success':j.status==='failed'?'bg-danger':j.status==='running'?'bg-primary':j.status==='cancelled'?'bg-dark':'bg-secondary'}">${j.status}</span></td>
							<td><small>${waktu}</small></td>
							<td><small class="text-danger">${j.error || ''}</small></td>
							<td>${btn}</td>
						</tr>
					`;
				}).join('');
			}
			async function createJobs(mode = 'all') {
				const label = mode === 'belum_masuk' ? 'Belum Masuk' : mode === 'belum_pulang' ? 'Belum Pulang' : 'Semua (Belum Lengkap)';
				if (!confirm('Buat job scrape: ' + label + '?')) return;
				await fetch('/api/scrape?mode=' + mode, { method: 'POST' });
				loadStatus();
				showToast('Job scrape ' + label + ' dibuat');
			}
			async function retryFailed() {
				await fetch('/api/scrape/retry', { method: 'POST' });
				loadStatus();
				showToast('Job gagal di-retry', 'warning');
			}
			async function cancelAll() {
				if (!confirm('Batalkan SEMUA job pending & running?')) return;
				const res = await fetch('/api/scrape/cancel-all', { method: 'POST' });
				const d = await res.json();
				loadStatus();
				if (d.success) showToast(d.data.cancelled + ' job dibatalkan');
				else showToast(d.error || 'Gagal', 'danger');
			}
			async function cancelOne(id) {
				if (!confirm('Batalkan job ini?')) return;
				const res = await fetch('/api/scrape/' + id + '/cancel', { method: 'POST' });
				const d = await res.json();
				loadStatus();
				if (d.success) showToast('Job dibatalkan');
				else showToast(d.error || 'Gagal', 'danger');
			}
			loadStatus();
			setInterval(loadStatus, 5000);
		</script>
	}
}
