package templates

templ SettingsPage(username string, role string) {
	@Layout("Pengaturan", username, role) {
		@Sidebar("settings")
		<div class="main-content">
			@Topbar("Pengaturan")
			<div class="content">
				<!-- Info Akun -->
				<div class="card mb-4">
					<header class="card-header"><i class="bi bi-person-badge"></i> Info Akun</header>
					<section class="card-body">
						<div class="grid grid-cols-3 gap-2 mb-2">
							<div class="text-muted-foreground">Username</div>
							<div class="col-span-2 font-semibold">{ username }</div>
						</div>
						<div class="grid grid-cols-3 gap-2">
							<div class="text-muted-foreground">Role</div>
							<div class="col-span-2"><span class="badge">{ role }</span></div>
						</div>
					</section>
				</div>
				if role == "superadmin" {
					<!-- Super Admin Menu -->
					<div class="card mb-2">
						<header class="card-header"><i class="bi bi-shield-lock"></i> Super Admin</header>
						<section class="card-body">
							<a href="/approval" class="btn w-full mb-2" data-variant="outline">
								<i class="bi bi-check-circle"></i> Kelola Pendaftaran
							</a>
							<a href="/superadmin/users" class="btn w-full" data-variant="outline">
								<i class="bi bi-people"></i> User Management
							</a>
						</section>
					</div>
					<!-- Worker Concurrency -->
					<div class="card mb-2">
						<header class="card-header"><i class="bi bi-cpu"></i> Worker Scrape</header>
						<section class="card-body">
							<label class="label font-semibold">Jumlah Worker Paralel</label>
							<div class="flex gap-2">
								<input type="number" min="1" max="100" class="input" id="concInput" value="8"/>
								<button class="btn btn-sm" data-variant="outline" onclick="saveConc()">Simpan</button>
							</div>
							<small class="text-muted-foreground">Makin tinggi makin cepat, tapi hati-hati rate-limit Pusaka (max 60 req/jam/akun).</small>
						</section>
					</div>
					<!-- Import Pegawai -->
					<div class="card mb-2">
						<header class="card-header"><i class="bi bi-upload"></i> Import Pegawai</header>
						<section class="card-body">
							<input type="file" class="input mb-2" id="pegawaiFile" accept=".json"/>
							<button class="btn btn-sm w-full" onclick="importPegawai()">
								<i class="bi bi-cloud-upload"></i> Import dari JSON
							</button>
						</section>
					</div>
				}
			</div>
		</div>
		@BottomNav("settings")
		<script>
			(async () => {
				try {
					const res = await fetch('/api/admin/concurrency');
					const d = await res.json();
					if (d.success) document.getElementById('concInput').value = d.data.concurrency;
				} catch {}
			})();

			async function saveConc() {
				const n = parseInt(document.getElementById('concInput').value) || 1;
				const res = await fetch('/api/admin/concurrency', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({concurrency: n})
				});
				const d = await res.json();
				if (d.success) showToast('Worker diatur ke ' + n);
				else showToast(d.error || 'Gagal', 'danger');
			}

			async function importPegawai() {
				const fileInput = document.getElementById('pegawaiFile');
				if (!fileInput.files.length) { showToast('Pilih file JSON dulu', 'warning'); return; }
				const formData = new FormData();
				formData.append('file', fileInput.files[0]);
				const res = await fetch('/api/admin/import-pegawai', { method: 'POST', body: formData });
				const d = await res.json();
				if (d.success) showToast('Import: ' + d.data.imported + ' pegawai, ' + d.data.skipped + ' skip');
				else showToast(d.error || 'Gagal', 'danger');
			}
		</script>
	}
}
