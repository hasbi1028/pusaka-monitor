package templates

import "fmt"

// namaBulan — konversi angka ke nama bulan Indonesia
func namaBulan(i int) string {
	bulan := []string{
		"Januari", "Februari", "Maret", "April", "Mei", "Juni",
		"Juli", "Agustus", "September", "Oktober", "November", "Desember",
	}
	if i >= 1 && i <= 12 {
		return bulan[i-1]
	}
	return fmt.Sprintf("%d", i)
}

templ Layout(title string, username string, role string) {
	<!DOCTYPE html>
	<html lang="id" data-bs-theme="light">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } - Pusaka Monitor</title>
		<link href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/basecoat.cdn.min.css" rel="stylesheet"/>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
		<link href="/static/css/app.css?v=3" rel="stylesheet"/>
	</head>
	<body class="bg-background text-foreground">
		<div class="marquee-bar">
			<div class="marquee-content">
				<i class="bi bi-info-circle"></i> Aplikasi ini <strong>HANYA membaca</strong> riwayat presensi dari Pusaka Kemenag &mdash; tidak melakukan, mengubah, atau membuat data absensi fiktif/palsu. &nbsp;&nbsp;&bull;&nbsp;&nbsp; Data diambil secara otomatis untuk rekap kehadiran &nbsp;&nbsp;&bull;&nbsp;&nbsp; Pusaka Monitor v1.0
			</div>
		</div>
		{ children... }
		<footer class="app-disclaimer">
			<i class="bi bi-info-circle"></i>
			Aplikasi ini <strong>HANYA membaca</strong> riwayat presensi dari Pusaka Kemenag.
			Tidak melakukan, mengubah, atau membuat data absensi fiktif/palsu.
		</footer>
		<script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/basecoat.min.js" defer></script>
		<script src="/static/js/app.js"></script>
	</body>
	</html>
}

templ Sidebar(activePage string) {
	<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
	<aside class="sidebar" id="sidebar">
		<div class="brand">
			<i class="bi bi-calendar-check"></i>
			<span>Pusaka Monitor</span>
		</div>
		<nav class="nav-menu">
			<a href="/" class={ "nav-link", activePage == "dashboard" }><i class="bi bi-house-door"></i> Beranda</a>
			<a href="/pegawai" class={ "nav-link", activePage == "pegawai" }><i class="bi bi-people"></i> Pegawai</a>
			<a href="/scrape" class={ "nav-link", activePage == "scrape" }><i class="bi bi-arrow-repeat"></i> Scrape</a>
			<a href="/profil" class={ "nav-link", activePage == "profil" }><i class="bi bi-person-circle"></i> Profil</a>
			<a href="/settings" class={ "nav-link", activePage == "settings" }><i class="bi bi-gear"></i> Pengaturan</a>
			<a href="/superadmin/users" class={ "nav-link", activePage == "users" }><i class="bi bi-people-fill"></i> User Mgmt</a>
			<a href="#" onclick="logout()" class="nav-link logout-link"><i class="bi bi-box-arrow-right"></i> Keluar</a>
		</nav>
	</aside>
}

templ Topbar(title string) {
	<header class="topbar">
		<div class="flex items-center gap-2">
			<button class="btn" data-variant="ghost" data-size="icon" onclick="toggleSidebar()">
				<i class="bi bi-list"></i>
			</button>
			<span class="page-title">{ title }</span>
		</div>
	</header>
}

templ BottomNav(activePage string) {
	<nav class="bottom-nav">
		<a href="/" class={ "nav-link", activePage == "dashboard" }><i class="bi bi-house-door"></i><span>Beranda</span></a>
		<a href="/pegawai" class={ "nav-link", activePage == "pegawai" }><i class="bi bi-people"></i><span>Pegawai</span></a>
		<a href="/scrape" class={ "nav-link", activePage == "scrape" }><i class="bi bi-arrow-repeat"></i><span>Scrape</span></a>
		<a href="/settings" class={ "nav-link", activePage == "settings" }><i class="bi bi-gear"></i><span>Lainnya</span></a>
	</nav>
}
