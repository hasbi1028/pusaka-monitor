package templates

// Halaman Profil — self-reset password
templ ProfilPage() {
	@Layout("Profil", "", "") {
		@Sidebar("profil")
		<div class="main-content">
			@Topbar("Profil")
			<div class="content">
				<div class="card mb-2">
					<header class="card-header py-2"><i class="bi bi-person-circle"></i> Akun Saya</header>
					<section class="card-body py-2">
						<p class="mb-1"><strong>Username:</strong> <span id="meUser">-</span></p>
						<p class="mb-0"><strong>Role:</strong> <span id="meRole">-</span></p>
					</section>
				</div>
				<div class="card">
					<header class="card-header py-2"><i class="bi bi-key"></i> Ganti Password</header>
					<section class="card-body">
						<div class="grid gap-2 mb-3">
							<label class="label font-semibold">Password Lama</label>
							<input type="password" class="input" id="oldPwd" placeholder="Password saat ini"/>
						</div>
						<div class="grid gap-2 mb-3">
							<label class="label font-semibold">Password Baru</label>
							<input type="password" class="input" id="newPwd" placeholder="Minimal 4 karakter"/>
						</div>
						<button class="btn w-full" onclick="resetOwn()">
							<i class="bi bi-check-lg"></i> Simpan Password Baru
						</button>
					</section>
				</div>
			</div>
		</div>
		@BottomNav("profil")
		<script>
			async function loadMe() {
				const res = await fetch('/api/auth/me');
				const d = await res.json();
				if (d.success) {
					document.getElementById('meUser').textContent = d.data.username || '-';
					document.getElementById('meRole').textContent = d.data.role || '-';
				}
			}
			async function resetOwn() {
				const oldP = document.getElementById('oldPwd').value;
				const newP = document.getElementById('newPwd').value;
				if (!oldP || !newP) { showToast('Isi password lama & baru', 'danger'); return; }
				const res = await fetch('/api/me/reset-password', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({ old_password: oldP, new_password: newP })
				});
				const d = await res.json();
				if (d.success) {
					showToast('Password berhasil diubah');
					document.getElementById('oldPwd').value = '';
					document.getElementById('newPwd').value = '';
				} else {
					showToast(d.error || 'Gagal', 'danger');
				}
			}
			loadMe();
		</script>
	}
}

// Halaman User Management (superadmin) — list user + reset password
templ UsersPage() {
	@Layout("User Management", "", "") {
		@Sidebar("users")
		<div class="main-content">
			@Topbar("User Management")
			<div class="content">
				<div class="card">
					<header class="card-header py-2"><i class="bi bi-people"></i> Daftar User</header>
					<div class="table-container">
						<table class="table">
							<thead><tr><th>Username</th><th>Role</th><th>Instansi</th><th></th></tr></thead>
							<tbody id="userTable">
								<tr><td colspan="4" class="text-center text-muted-foreground py-4">Memuat...</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		@BottomNav("users")
		<script>
			async function loadUsers() {
				const res = await fetch('/api/superadmin/users');
				const d = await res.json();
				if (!d.success) return;
				const tb = document.getElementById('userTable');
				tb.innerHTML = d.data.map(u => `
					<tr>
						<td>${u.username}</td>
						<td><span class="badge ${u.role==='superadmin'?'badge-alfa':'badge-hadir'}">${u.role}</span></td>
						<td><small class="text-muted-foreground">${u.instansi_nama || '-'}</small></td>
						<td class="text-end">
							<button class="btn" data-variant="outline" onclick="resetUser('${u.id}','${u.username}')"><i class="bi bi-key"></i> Reset</button>
						</td>
					</tr>
				`).join('');
			}
			function resetUser(id, username) {
				const pwd = prompt('Password baru untuk ' + username + ' (minimal 4 karakter):');
				if (!pwd || pwd.length < 4) { if (pwd!==null) showToast('Minimal 4 karakter', 'danger'); return; }
				fetch('/api/superadmin/users/' + id + '/reset-password', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({ new_password: pwd })
				}).then(r => r.json()).then(d => {
					if (d.success) showToast('Password ' + username + ' direset');
					else showToast(d.error || 'Gagal', 'danger');
				});
			}
			loadUsers();
		</script>
	}
}
