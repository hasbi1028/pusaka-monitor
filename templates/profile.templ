package templates

// Halaman Profil — self-reset password
templ ProfilPage() {
	@Layout("Profil", "", "") {
		@Sidebar("profil")
		<div class="lg:pl-56 min-h-screen pb-20 lg:pb-0">
			@Topbar("Profil", "")
			<main class="p-4 page-enter">
				<!-- Akun Saya -->
				<div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-4">
					<div class="px-4 py-2.5 border-b border-gray-200 text-sm font-semibold text-gray-700">
						<i class="fa-solid fa-circle-user mr-1"></i> Akun Saya
					</div>
					<div class="p-4 space-y-2">
						<div class="flex justify-between text-sm">
							<span class="text-gray-500">Username</span>
							<span class="font-semibold text-gray-900" id="meUser">-</span>
						</div>
						<div class="flex justify-between text-sm">
							<span class="text-gray-500">Role</span>
							<span class="text-gray-900" id="meRole">-</span>
						</div>
					</div>
				</div>
				<!-- Ganti Password -->
				<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
					<div class="px-4 py-2.5 border-b border-gray-200 text-sm font-semibold text-gray-700">
						<i class="fa-solid fa-key mr-1"></i> Ganti Password
					</div>
					<div class="p-4 space-y-3">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Password Lama</label>
							<input type="password" id="oldPwd" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" placeholder="Password saat ini"/>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Password Baru</label>
							<input type="password" id="newPwd" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" placeholder="Minimal 4 karakter"/>
						</div>
						<button onclick="resetOwn()" class="w-full px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">
							<i class="fa-solid fa-check mr-1"></i> Simpan Password Baru
						</button>
					</div>
				</div>
			</main>
		</div>
		@BottomNav("profil")
		<script>
			async function loadMe() {
				const res = await fetch('/api/auth/me');
				const d = await res.json();
				if (d.success) {
					document.getElementById('meUser').textContent = d.data.username || '-';
					document.getElementById('meRole').textContent = d.data.role || '-';
				}
			}
			async function resetOwn() {
				const oldP = document.getElementById('oldPwd').value;
				const newP = document.getElementById('newPwd').value;
				if (!oldP || !newP) { showToast('Isi password lama & baru','danger'); return; }
				const res = await fetch('/api/me/reset-password', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({old_password:oldP,new_password:newP})});
				const d = await res.json();
				if (d.success) { showToast('Password berhasil diubah'); document.getElementById('oldPwd').value=''; document.getElementById('newPwd').value=''; }
				else showToast(d.error||'Gagal','danger');
			}
			loadMe();
		</script>
	}
}

// Halaman User Management (superadmin) — list user + reset password
templ UsersPage() {
	@Layout("User Management", "", "") {
		@Sidebar("users")
		<div class="lg:pl-56 min-h-screen pb-20 lg:pb-0">
			@Topbar("User Management", "")
			<main class="p-4 page-enter">
				<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
					<div class="px-4 py-2.5 border-b border-gray-200 text-sm font-semibold text-gray-700">
						<i class="fa-solid fa-users mr-1"></i> Daftar User
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead class="bg-gray-50 text-gray-500 text-xs uppercase">
								<tr><th class="px-4 py-2 text-left">Username</th><th class="px-4 py-2 text-center">Role</th><th class="px-4 py-2 text-left">Instansi</th><th class="px-4 py-2 text-right">Aksi</th></tr>
							</thead>
							<tbody id="userTable" class="divide-y divide-gray-100">
								<tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-sm">Memuat...</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</main>
		</div>
		@BottomNav("users")
		<script>
			async function loadUsers() {
				const res = await fetch('/api/superadmin/users');
				const d = await res.json();
				if (!d.success) return;
				const tb = document.getElementById('userTable');
				tb.innerHTML = d.data.map(u => `<tr class="hover:bg-gray-50">
					<td class="px-4 py-2 font-medium text-gray-900">${u.username}</td>
					<td class="px-4 py-2 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${u.role==='superadmin'?'bg-red-100 text-red-700':'bg-gray-100 text-gray-600'}">${u.role}</span></td>
					<td class="px-4 py-2 text-gray-500 text-xs">${u.instansi_nama || '-'}</td>
					<td class="px-4 py-2 text-right">
						<button onclick="resetUser('${u.id}','${u.username}')" class="px-3 py-1 border border-gray-200 rounded-lg text-xs font-medium hover:bg-gray-50 transition-colors">
							<i class="fa-solid fa-key mr-1"></i>Reset
						</button>
					</td>
				</tr>`).join('');
			}
			function resetUser(id, username) {
				const pwd = prompt('Password baru untuk ' + username + ' (minimal 4 karakter):');
				if (!pwd || pwd.length < 4) { if (pwd!==null) showToast('Minimal 4 karakter','danger'); return; }
				fetch('/api/superadmin/users/'+id+'/reset-password', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({new_password:pwd})})
				.then(r=>r.json()).then(d => { if (d.success) showToast('Password '+username+' direset'); else showToast(d.error||'Gagal','danger'); });
			}
			loadUsers();
		</script>
	}
}
