package templates

templ ApprovalPage() {
	@Layout("Approval", "", "") {
		@Sidebar("settings")
		<div class="lg:pl-56 min-h-screen pb-20 lg:pb-0">
			@Topbar("Approval", "")
			<main class="p-4 page-enter">
				<!-- Pending -->
				<h3 class="text-sm font-semibold text-gray-500 mb-3"><i class="fa-solid fa-hourglass-half mr-1"></i> Menunggu Persetujuan</h3>
				<div id="pendingList" class="mb-6 space-y-3">
					<div class="text-center text-gray-400 text-sm py-4">Memuat...</div>
				</div>
				<hr class="border-gray-200 mb-4"/>
				<!-- Riwayat -->
				<h3 class="text-sm font-semibold text-gray-500 mb-3"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Riwayat</h3>
				<div id="recentList" class="space-y-2">
					<div class="text-center text-gray-400 text-sm py-4">Memuat...</div>
				</div>
			</main>
		</div>
		@BottomNav("settings")
		<script>
			async function loadApproval() {
				const res = await fetch('/superadmin/approval');
				const data = await res.json();
				if (!data.success) return;
				const pendingDiv = document.getElementById('pendingList');
				if (data.data.pending.length === 0) {
					pendingDiv.innerHTML = '<div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center text-green-700 text-sm"><i class="fa-solid fa-circle-check mr-1"></i> Tidak ada pendaftaran menunggu</div>';
				} else {
					pendingDiv.innerHTML = data.data.pending.map(i => `
						<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
							<div class="flex items-start justify-between mb-3">
								<div>
									<h4 class="text-sm font-semibold text-gray-900">${i.nama}</h4>
									<p class="text-xs text-gray-500">${i.jns_instansi.toUpperCase()} · ${i.kabupaten}, ${i.provinsi}</p>
									<p class="text-xs text-gray-400 mt-1">Username: ${i.username || '-'} · WA: ${i.telepon || '-'}</p>
								</div>
								<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Pending</span>
							</div>
							<div class="flex gap-2">
								<button onclick="approve('${i.id}')" class="flex-1 px-3 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-xs font-medium transition-colors">
									<i class="fa-solid fa-check mr-1"></i>Setujui
								</button>
								<button onclick="reject('${i.id}')" class="flex-1 px-3 py-2 bg-red-50 hover:bg-red-100 text-red-700 rounded-lg text-xs font-medium transition-colors">
									<i class="fa-solid fa-xmark mr-1"></i>Tolak
								</button>
							</div>
						</div>
					`).join('');
				}
				const recentDiv = document.getElementById('recentList');
				if (data.data.recent.length === 0) {
					recentDiv.innerHTML = '<div class="text-center text-gray-400 text-sm py-3">Belum ada riwayat</div>';
				} else {
					recentDiv.innerHTML = data.data.recent.map(i => `
						<div class="bg-white rounded-xl border border-gray-200 shadow-sm px-4 py-2.5 flex items-center justify-between">
							<div>
								<span class="text-sm font-medium text-gray-900">${i.nama}</span>
								<span class="text-xs text-gray-400 ml-2">${i.kabupaten}</span>
							</div>
							<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${i.status==='approved'?'bg-green-100 text-green-700':'bg-red-100 text-red-700'}">${i.status}</span>
						</div>
					`).join('');
				}
			}
			async function approve(id) {
				if (!confirm('Setujui pendaftaran ini?')) return;
				await fetch('/api/approval/'+id, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'approve'})});
				loadApproval(); showToast('Pendaftaran disetujui');
			}
			async function reject(id) {
				const reason = prompt('Alasan penolakan:');
				if (reason === null) return;
				await fetch('/api/approval/'+id, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'reject',reason})});
				loadApproval(); showToast('Pendaftaran ditolak','danger');
			}
			loadApproval();
		</script>
	}
}
