package templates

templ ApprovalPage() {
	@Layout("Approval", "", "") {
		@Sidebar("settings")
		<div class="main-content">
			@Topbar("Approval")
			<div class="content">
				<h6 class="text-muted-foreground mb-3"><i class="bi bi-hourglass-split"></i> Menunggu Persetujuan</h6>
				<div id="pendingList" class="mb-4">
					<div class="text-center text-muted-foreground py-4">Memuat...</div>
				</div>
				<hr/>
				<h6 class="text-muted-foreground mb-3"><i class="bi bi-clock-history"></i> Riwayat</h6>
				<div id="recentList">
					<div class="text-center text-muted-foreground py-4">Memuat...</div>
				</div>
			</div>
		</div>
		@BottomNav("settings")
		<script>
			async function loadApproval() {
				const res = await fetch('/superadmin/approval');
				const data = await res.json();
				if (data.success) {
					const pendingDiv = document.getElementById('pendingList');
					if (data.data.pending.length === 0) {
						pendingDiv.innerHTML = '<div class="alert"><i class="bi bi-check-circle"></i><section>Tidak ada pendaftaran menunggu</section></div>';
					} else {
						pendingDiv.innerHTML = data.data.pending.map(i => `
							<div class="card mb-3">
								<section class="">
									<div class="flex justify-between items-start">
										<div>
											<h6 class="mb-1">${i.nama}</h6>
											<p class="mb-1 text-muted-foreground"><small>${i.jns_instansi.toUpperCase()} · ${i.kabupaten}, ${i.provinsi}</small></p>
											<p class="mb-2 text-muted-foreground"><small>Username: ${i.username || '-'} · WA: ${i.telepon || '-'}</small></p>
										</div>
										<span class="badge" data-variant="secondary">Pending</span>
									</div>
									<div class="flex gap-2">
										<button class="btn" data-variant="outline" onclick="approve('${i.id}')">
											<i class="bi bi-check-lg"></i> Setujui
										</button>
										<button class="btn" data-variant="destructive" onclick="reject('${i.id}')">
											<i class="bi bi-x-lg"></i> Tolak
										</button>
									</div>
								</section>
							</div>
						`).join('');
					}
					const recentDiv = document.getElementById('recentList');
					if (data.data.recent.length === 0) {
						recentDiv.innerHTML = '<div class="text-muted-foreground text-center py-3">Belum ada riwayat</div>';
					} else {
						recentDiv.innerHTML = data.data.recent.map(i => `
							<div class="card mb-2">
								<section class="py-2 flex items-center justify-between">
									<div>
										<strong>${i.nama}</strong>
										<small class="text-muted-foreground ms-2">${i.kabupaten}</small>
									</div>
									<span class="badge ${i.status==='approved'?'data-variant=\"secondary\"':'data-variant=\"destructive\"'}">${i.status}</span>
								</section>
							</div>
						`).join('');
					}
				}
			}
			async function approve(id) {
				if (!confirm('Setujui pendaftaran ini?')) return;
				await fetch(`/api/approval/${id}`, {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({action: 'approve'})
				});
				loadApproval();
				showToast('Pendaftaran disetujui');
			}
			async function reject(id) {
				const reason = prompt('Alasan penolakan:');
				if (reason === null) return;
				await fetch(`/api/approval/${id}`, {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({action: 'reject', reason})
				});
				loadApproval();
				showToast('Pendaftaran ditolak', 'danger');
			}
			loadApproval();
		</script>
	}
}
