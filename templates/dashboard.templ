package templates

templ DashboardPage(username string) {
	@Layout("Dashboard", username, "") {
		@Sidebar("dashboard")
		<div class="lg:pl-56 min-h-screen pb-20 lg:pb-0">
			@Topbar("Dashboard", username)
			<main class="p-4 page-enter">
				<!-- Marquee Banner -->
				<div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-2 mb-4 text-xs text-blue-700 overflow-hidden">
					<i class="fa-solid fa-circle-info mr-1"></i>
					<strong>HANYA membaca</strong> riwayat presensi dari Pusaka Kemenag — tidak mengubah atau membuat data.
				</div>
				<!-- Stat Cards -->
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-4">
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-gray-400">
						<div class="text-xl font-bold text-gray-900" id="total">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Total</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-green-500">
						<div class="text-xl font-bold text-green-600" id="hadir">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Hadir</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-yellow-500">
						<div class="text-xl font-bold text-yellow-600" id="telat">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Telat</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-orange-500">
						<div class="text-xl font-bold text-orange-600" id="belumMasuk">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Blm Masuk</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-cyan-500">
						<div class="text-xl font-bold text-cyan-600" id="belumPulang">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Blm Pulang</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 p-3 shadow-sm border-l-4 border-l-red-500">
						<div class="text-xl font-bold text-red-600" id="alfa">-</div>
						<div class="text-[10px] text-gray-500 uppercase tracking-wide">Alfa</div>
					</div>
				</div>
				<!-- Tab Switcher -->
				<div class="flex gap-2 mb-4">
					<button id="tabHarian" onclick="setMode('harian')" class="px-4 py-1.5 rounded-lg text-sm font-medium bg-blue-600 text-white transition-colors">
						<i class="fa-solid fa-calendar-day mr-1"></i>Harian
					</button>
					<button id="tabBulanan" onclick="setMode('bulanan')" class="px-4 py-1.5 rounded-lg text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-colors">
						<i class="fa-solid fa-calendar mr-1"></i>Bulanan
					</button>
				</div>
				<!-- Harian View -->
				<div id="harianView">
					<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 mb-4">
						<div class="flex items-center gap-2 flex-wrap">
							<label class="text-sm font-medium text-gray-700">Tanggal:</label>
							<input type="date" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" id="datePicker" onchange="loadDashboard()"/>
							<button class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm transition-colors" onclick="loadDashboard()">
								<i class="fa-solid fa-magnifying-glass"></i>
							</button>
						</div>
					</div>
					<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
						<div class="px-4 py-2.5 border-b border-gray-200 flex items-center justify-between">
							<span class="text-sm font-semibold text-gray-700"><i class="fa-solid fa-table mr-1"></i> Presensi</span>
							<span class="bg-gray-100 text-gray-600 text-xs font-medium px-2 py-0.5 rounded-full" id="tableCount">0</span>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full text-sm">
								<thead class="bg-gray-50 text-gray-500 text-xs uppercase">
									<tr><th class="px-4 py-2 text-left">Nama</th><th class="px-4 py-2 text-center">Masuk</th><th class="px-4 py-2 text-center">Pulang</th><th class="px-4 py-2 text-center">Status</th></tr>
								</thead>
								<tbody id="absensiTable" class="divide-y divide-gray-100">
									<tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-sm">Memuat...</td></tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- Bulanan View -->
				<div id="bulananView" class="hidden">
					<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 mb-4">
						<div class="flex items-center gap-2 flex-wrap">
							<label class="text-sm font-medium text-gray-700">Bulan:</label>
							<select class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 outline-none" id="bulanPicker" onchange="loadBulan()">
								for i := 1; i <= 12; i++ {
									<option value={ i }>{ namaBulan(i) }</option>
								}
							</select>
							<label class="text-sm font-medium text-gray-700">Tahun:</label>
							<select class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 outline-none" id="tahunPicker" onchange="loadBulan()">
								<option value="2026">2026</option>
								<option value="2025">2025</option>
							</select>
							<button class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm hover:bg-gray-50 transition-colors" onclick="exportCSV()">
								<i class="fa-solid fa-download mr-1"></i>CSV
							</button>
						</div>
					</div>
					<!-- Sub-tabs -->
					<div class="flex gap-2 mb-4">
						<button id="subRekap" onclick="setBulanMode('rekap')" class="px-4 py-1.5 rounded-lg text-sm font-medium bg-blue-600 text-white transition-colors">
							Rekap Pegawai
						</button>
						<button id="subDetail" onclick="setBulanMode('detail')" class="px-4 py-1.5 rounded-lg text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-colors">
							Detail Harian
						</button>
					</div>
					<!-- Rekap -->
					<div id="bulanRekapView">
						<div class="grid grid-cols-3 gap-3 mb-4">
							<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3 text-center">
								<div class="text-lg font-bold" id="sumHari">-</div>
								<div class="text-[10px] text-gray-500 uppercase">Hari Kerja</div>
							</div>
							<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3 text-center">
								<div class="text-lg font-bold text-green-600" id="sumRata">-</div>
								<div class="text-[10px] text-gray-500 uppercase">% Hadir</div>
							</div>
							<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3 text-center">
								<div class="text-lg font-bold" id="sumPeg">-</div>
								<div class="text-[10px] text-gray-500 uppercase">Pegawai</div>
							</div>
						</div>
						<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
							<div class="px-4 py-2.5 border-b border-gray-200 text-sm font-semibold text-gray-700">
								<i class="fa-solid fa-users mr-1"></i> Rekap per Pegawai
							</div>
							<div class="overflow-x-auto max-h-[50vh] overflow-y-auto">
								<table class="w-full text-sm">
									<thead class="bg-gray-50 text-gray-500 text-xs uppercase sticky top-0">
										<tr><th class="px-4 py-2 text-left">Nama</th><th class="px-4 py-2 text-center">Hadir</th><th class="px-4 py-2 text-center">Telat</th><th class="px-4 py-2 text-center">Alfa</th><th class="px-4 py-2 text-center">%</th></tr>
									</thead>
									<tbody id="bulanPegawaiTable" class="divide-y divide-gray-100">
										<tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">Memuat...</td></tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<!-- Detail -->
					<div id="bulanDetailView" class="hidden">
						<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
							<div class="px-4 py-2.5 border-b border-gray-200 text-sm font-semibold text-gray-700">
								<i class="fa-solid fa-list-ul mr-1"></i> Detail Harian
							</div>
							<div class="overflow-x-auto max-h-[55vh] overflow-y-auto">
								<table class="w-full text-sm">
									<thead class="bg-gray-50 text-gray-500 text-xs uppercase sticky top-0">
										<tr><th class="px-4 py-2 text-left">Tanggal</th><th class="px-4 py-2 text-left">Nama</th><th class="px-4 py-2 text-center">Masuk</th><th class="px-4 py-2 text-center">Pulang</th><th class="px-4 py-2 text-center">Status</th></tr>
									</thead>
									<tbody id="bulanDetailTable" class="divide-y divide-gray-100">
										<tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">Memuat...</td></tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
		@BottomNav("dashboard")
		<script>
			let currentMode = 'harian';
			const bln = new Date().getMonth() + 1;
			document.getElementById('datePicker').value = new Date().toISOString().split('T')[0];
			document.getElementById('bulanPicker').value = bln;
			loadDashboard();

			function setActive(tabId, otherId) {
				const t = document.getElementById(tabId);
				const o = document.getElementById(otherId);
				t.className = 'px-4 py-1.5 rounded-lg text-sm font-medium bg-blue-600 text-white transition-colors';
				o.className = 'px-4 py-1.5 rounded-lg text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition-colors';
			}

			function setMode(m) {
				currentMode = m;
				document.getElementById('harianView').classList.toggle('hidden', m !== 'harian');
				document.getElementById('bulananView').classList.toggle('hidden', m !== 'bulanan');
				setActive(m === 'harian' ? 'tabHarian' : 'tabBulanan', m === 'harian' ? 'tabBulanan' : 'tabHarian');
				if (m === 'bulanan') loadBulan();
			}

			function statusBadge(s) {
				const map = {
					'Belum Masuk': 'bg-gray-100 text-gray-600',
					'Belum Pulang': 'bg-gray-100 text-gray-600',
					'Terlambat': 'bg-red-100 text-red-700',
					'Telat Ringan': 'bg-yellow-100 text-yellow-700',
					'Tepat Waktu': 'bg-green-100 text-green-700',
					'Hadir': 'bg-green-100 text-green-700'
				};
				return map[s] || 'bg-gray-100 text-gray-600';
			}

			async function loadDashboard() {
				const tgl = document.getElementById('datePicker').value;
				const res = await fetch('/api/dashboard?tanggal=' + tgl);
				const d = await res.json();
				if (!d.success) return;
				const r = d.data.rekap;
				document.getElementById('total').textContent = r.total || 0;
				document.getElementById('hadir').textContent = r.hadir || 0;
				document.getElementById('telat').textContent = r.terlambat || 0;
				document.getElementById('belumMasuk').textContent = r.belum_masuk || 0;
				document.getElementById('belumPulang').textContent = r.belum_pulang || 0;
				document.getElementById('alfa').textContent = r.tidak_hadir || 0;
				const tb = document.getElementById('absensiTable');
				const rows = d.data.absensi;
				document.getElementById('tableCount').textContent = rows.length;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-sm">Belum ada data</td></tr>';
				} else {
					tb.innerHTML = rows.map(a => `<tr class="hover:bg-gray-50">
						<td class="px-4 py-2 font-medium text-gray-900">${a.nama}</td>
						<td class="px-4 py-2 text-center text-gray-600">${a.jam_masuk || '-'}</td>
						<td class="px-4 py-2 text-center text-gray-600">${a.jam_pulang || '-'}</td>
						<td class="px-4 py-2 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(a.status)}">${a.status || (a.jam_masuk ? 'Hadir' : 'Alfa')}</span></td>
					</tr>`).join('');
				}
			}

			async function loadBulan() { loadBulanPegawai(); loadBulanDetail(); }

			function setBulanMode(m) {
				document.getElementById('bulanRekapView').classList.toggle('hidden', m !== 'rekap');
				document.getElementById('bulanDetailView').classList.toggle('hidden', m !== 'detail');
				setActive(m === 'rekap' ? 'subRekap' : 'subDetail', m === 'rekap' ? 'subDetail' : 'subRekap');
				if (m === 'detail') loadBulanDetail(); else loadBulanPegawai();
			}

			async function loadBulanPegawai() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				const res = await fetch('/api/dashboard/bulan-pegawai?bulan=' + bln + '&tahun=' + thn);
				const d = await res.json();
				if (!d.success) return;
				document.getElementById('sumHari').textContent = d.data.hari_kerja || 0;
				document.getElementById('sumPeg').textContent = d.data.rekap_pegawai.length || 0;
				const tb = document.getElementById('bulanPegawaiTable');
				const rows = d.data.rekap_pegawai;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">Belum ada data</td></tr>';
					document.getElementById('sumRata').textContent = '0%';
					return;
				}
				let totalHadir = 0, totalHK = (d.data.hari_kerja || 0) * rows.length;
				rows.forEach(r => totalHadir += r.hadir);
				const rata = totalHK > 0 ? (totalHadir / totalHK * 100).toFixed(0) + '%' : '0%';
				document.getElementById('sumRata').textContent = rata;
				tb.innerHTML = rows.map(r => `<tr class="hover:bg-gray-50">
					<td class="px-4 py-2 font-medium text-gray-900">${r.nama}</td>
					<td class="px-4 py-2 text-center text-green-600 font-medium">${r.hadir}</td>
					<td class="px-4 py-2 text-center text-yellow-600">${r.terlambat}</td>
					<td class="px-4 py-2 text-center text-red-600">${r.tidak_hadir}</td>
					<td class="px-4 py-2 text-center font-bold ${r.persen >= 80 ? 'text-green-600' : 'text-red-600'}">${r.persen.toFixed(0)}%</td>
				</tr>`).join('');
			}

			async function loadBulanDetail() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				const res = await fetch('/api/dashboard/bulan-detail?bulan=' + bln + '&tahun=' + thn);
				const d = await res.json();
				if (!d.success) return;
				const tb = document.getElementById('bulanDetailTable');
				const rows = d.data.detail;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">Belum ada data</td></tr>';
					return;
				}
				tb.innerHTML = rows.map(a => `<tr class="hover:bg-gray-50">
					<td class="px-4 py-2 text-gray-600">${a.tanggal}</td>
					<td class="px-4 py-2 font-medium text-gray-900">${a.nama}</td>
					<td class="px-4 py-2 text-center text-gray-600">${a.jam_masuk || '-'}</td>
					<td class="px-4 py-2 text-center text-gray-600">${a.jam_pulang || '-'}</td>
					<td class="px-4 py-2 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusBadge(a.status)}">${a.status || '-'}</span></td>
				</tr>`).join('');
			}

			function exportCSV() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				window.location.href = '/api/admin/export-csv?bulan=' + bln + '&tahun=' + thn;
			}
		</script>
	}
}
