package templates

templ DashboardPage(username string) {
	@Layout("Dashboard", username, "") {
		@Sidebar("dashboard")
		<div class="main-content">
			@Topbar("Dashboard")
			<div class="content">
				<!-- Stat Cards -->
				<div class="grid grid-cols-3 lg:grid-cols-6 gap-2 mb-2">
					<div class="stat-card total">
						<div class="number" id="total">-</div>
						<div class="label">Total</div>
					</div>
					<div class="stat-card hadir">
						<div class="number text-primary" id="hadir">-</div>
						<div class="label">Hadir</div>
					</div>
					<div class="stat-card telat">
						<div class="number text-yellow-600" id="telat">-</div>
						<div class="label">Telat</div>
					</div>
					<div class="stat-card warn">
						<div class="number text-orange-600" id="belumMasuk">-</div>
						<div class="label">Blm Masuk</div>
					</div>
					<div class="stat-card info">
						<div class="number text-cyan-600" id="belumPulang">-</div>
						<div class="label">Blm Pulang</div>
					</div>
					<div class="stat-card alfa">
						<div class="number text-destructive" id="alfa">-</div>
						<div class="label">Alfa</div>
					</div>
				</div>

				<!-- Tab Harian / Bulanan -->
				<div class="flex gap-2 mb-2" id="modeTabs">
					<button class="btn" data-size="sm" id="tabHarian" onclick="setMode('harian')">Harian</button>
					<button class="btn" data-size="sm" id="tabBulanan" onclick="setMode('bulanan')">Bulanan</button>
				</div>

				<!-- Harian -->
				<div id="harianView">
					<div class="card mb-2">
						<section class="py-2">
							<div class="flex items-center gap-2 flex-wrap">
								<label class="label mb-0 font-semibold">Tanggal:</label>
								<input type="date" class="input" style="width:auto;" id="datePicker" onchange="loadDashboard()"/>
								<button class="btn" data-size="sm" onclick="loadDashboard()"><i class="bi bi-search"></i></button>
							</div>
						</section>
					</div>
					<div class="card">
						<header class="flex justify-between items-center py-1">
							<span><i class="bi bi-table"></i> Presensi</span>
							<span class="badge" id="tableCount">0</span>
						</header>
						<div class="table-container">
							<table class="table">
								<thead><tr><th>Nama</th><th class="text-center">Masuk</th><th class="text-center">Pulang</th><th class="text-center">Status</th></tr></thead>
								<tbody id="absensiTable"><tr><td colspan="4" class="text-center text-muted-foreground py-3">Memuat...</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- Bulanan -->
				<div id="bulananView" style="display:none;">
					<div class="card mb-2">
						<section class="py-2">
							<div class="flex items-center gap-2 flex-wrap">
								<label class="label mb-0 font-semibold">Bulan:</label>
								<select class="input" style="width:auto;" id="bulanPicker" onchange="loadBulan()">
									for i := 1; i <= 12; i++ {
										<option value={ i }>{ namaBulan(i) }</option>
									}
								</select>
								<label class="label mb-0 font-semibold">Tahun:</label>
								<select class="input" style="width:auto;" id="tahunPicker" onchange="loadBulan()">
									<option value="2026">2026</option>
									<option value="2025">2025</option>
								</select>
								<button class="btn" data-variant="outline" data-size="sm" onclick="exportCSV()"><i class="bi bi-download"></i> CSV</button>
							</div>
						</section>
					</div>
					<!-- Sub-tab bulanan -->
					<div class="flex gap-2 mb-2" id="bulanTabs">
						<button class="btn" data-size="sm" id="subRekap" onclick="setBulanMode('rekap')">Rekap Pegawai</button>
						<button class="btn" data-size="sm" id="subDetail" onclick="setBulanMode('detail')">Detail Harian</button>
					</div>
					<div id="bulanRekapView">
						<div class="card mb-2">
							<section class="py-2">
								<div class="grid grid-cols-3 gap-2 text-center">
									<div><div class="font-bold" id="sumHari">-</div><div class="text-muted-foreground" style="font-size:0.65rem;">Hari Kerja</div></div>
									<div><div class="font-bold text-green-600" id="sumRata">-</div><div class="text-muted-foreground" style="font-size:0.65rem;">% Hadir</div></div>
									<div><div class="font-bold" id="sumPeg">-</div><div class="text-muted-foreground" style="font-size:0.65rem;">Pegawai</div></div>
								</div>
							</section>
						</div>
						<div class="card">
							<header class="py-1"><i class="bi bi-people"></i> Rekap per Pegawai</header>
							<div class="table-container" style="max-height:50vh; overflow-y:auto;">
								<table class="table">
									<thead><tr><th>Nama</th><th class="text-center">Hadir</th><th class="text-center">Telat</th><th class="text-center">Alfa</th><th class="text-center">%</th></tr></thead>
									<tbody id="bulanPegawaiTable"><tr><td colspan="5" class="text-center text-muted-foreground py-3">Memuat...</td></tr></tbody>
								</table>
							</div>
						</div>
					</div>
					<div id="bulanDetailView" style="display:none;">
						<div class="card">
							<header class="py-1"><i class="bi bi-list-ul"></i> Detail Harian</header>
							<div class="table-container" style="max-height:55vh; overflow-y:auto;">
								<table class="table">
									<thead><tr><th>Tanggal</th><th>Nama</th><th class="text-center">Masuk</th><th class="text-center">Pulang</th><th class="text-center">Status</th></tr></thead>
									<tbody id="bulanDetailTable"><tr><td colspan="5" class="text-center text-muted-foreground py-3">Memuat...</td></tr></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		@BottomNav("dashboard")
		<script>
			let currentMode = 'harian';
			const bln = new Date().getMonth() + 1;
			document.getElementById('datePicker').value = new Date().toISOString().split('T')[0];
			document.getElementById('bulanPicker').value = bln;
			document.getElementById('tabHarian').classList.add('active');
			loadDashboard();

			function setActiveTab(tabId, otherId) {
				document.getElementById(tabId).classList.add('active');
				document.getElementById(otherId).classList.remove('active');
			}

			function setMode(m) {
				currentMode = m;
				document.getElementById('harianView').style.display = m === 'harian' ? 'block' : 'none';
				document.getElementById('bulananView').style.display = m === 'bulanan' ? 'block' : 'none';
				setActiveTab(m === 'harian' ? 'tabHarian' : 'tabBulanan', m === 'harian' ? 'tabBulanan' : 'tabHarian');
				if (m === 'bulanan') loadBulan();
			}

			function statusBadge(s) {
				switch(s) {
					case 'Belum Masuk': return 'secondary';
					case 'Belum Pulang': return 'secondary';
					case 'Terlambat': return 'destructive';
					case 'Telat Ringan': return 'outline';
					case 'Tepat Waktu': return '';
					case 'Hadir': return '';
					default: return 'secondary';
				}
			}

			async function loadDashboard() {
				const tgl = document.getElementById('datePicker').value;
				const res = await fetch('/api/dashboard?tanggal=' + tgl);
				const d = await res.json();
				if (!d.success) return;
				const r = d.data.rekap;
				document.getElementById('total').textContent = r.total || 0;
				document.getElementById('hadir').textContent = r.hadir || 0;
				document.getElementById('telat').textContent = r.terlambat || 0;
				document.getElementById('belumMasuk').textContent = r.belum_masuk || 0;
				document.getElementById('belumPulang').textContent = r.belum_pulang || 0;
				document.getElementById('alfa').textContent = r.tidak_hadir || 0;
				const tb = document.getElementById('absensiTable');
				const rows = d.data.absensi;
				document.getElementById('tableCount').textContent = rows.length;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="4" class="text-center text-muted-foreground py-3">Belum ada data</td></tr>';
				} else {
					tb.innerHTML = rows.map(a => `
						<tr>
							<td>${a.nama}</td>
							<td class="text-center">${a.jam_masuk || '-'}</td>
							<td class="text-center">${a.jam_pulang || '-'}</td>
							<td class="text-center"><span class="badge ${statusBadge(a.status) ? 'data-variant='+JSON.stringify(statusBadge(a.status)) : ''}">${a.status || (a.jam_masuk ? 'Hadir' : 'Alfa')}</span></td>
						</tr>
					`).join('');
				}
			}

			async function loadBulan() {
				loadBulanPegawai();
				loadBulanDetail();
			}

			function setBulanMode(m) {
				document.getElementById('bulanRekapView').style.display = m === 'rekap' ? 'block' : 'none';
				document.getElementById('bulanDetailView').style.display = m === 'detail' ? 'block' : 'none';
				setActiveTab(m === 'rekap' ? 'subRekap' : 'subDetail', m === 'rekap' ? 'subDetail' : 'subRekap');
				if (m === 'detail') loadBulanDetail();
				else loadBulanPegawai();
			}

			async function loadBulanPegawai() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				const res = await fetch('/api/dashboard/bulan-pegawai?bulan=' + bln + '&tahun=' + thn);
				const d = await res.json();
				if (!d.success) return;
				document.getElementById('sumHari').textContent = d.data.hari_kerja || 0;
				document.getElementById('sumPeg').textContent = d.data.rekap_pegawai.length || 0;
				const tb = document.getElementById('bulanPegawaiTable');
				const rows = d.data.rekap_pegawai;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted-foreground py-3">Belum ada data</td></tr>';
					document.getElementById('sumRata').textContent = '0%';
					return;
				}
				let totalHadir = 0, totalHK = (d.data.hari_kerja || 0) * rows.length;
				rows.forEach(r => totalHadir += r.hadir);
				const rata = totalHK > 0 ? (totalHadir / totalHK * 100).toFixed(0) + '%' : '0%';
				document.getElementById('sumRata').textContent = rata;
				tb.innerHTML = rows.map(r => `
					<tr>
						<td>${r.nama}</td>
						<td class="text-center">${r.hadir}</td>
						<td class="text-center text-yellow-600">${r.terlambat}</td>
						<td class="text-center text-red-600">${r.tidak_hadir}</td>
						<td class="text-center font-bold ${r.persen >= 80 ? 'text-green-600' : 'text-red-600'}">${r.persen.toFixed(0)}%</td>
					</tr>
				`).join('');
			}

			async function loadBulanDetail() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				const res = await fetch('/api/dashboard/bulan-detail?bulan=' + bln + '&tahun=' + thn);
				const d = await res.json();
				if (!d.success) return;
				const tb = document.getElementById('bulanDetailTable');
				const rows = d.data.detail;
				if (rows.length === 0) {
					tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted-foreground py-3">Belum ada data</td></tr>';
					return;
				}
				tb.innerHTML = rows.map(a => `
					<tr>
						<td>${a.tanggal}</td>
						<td>${a.nama}</td>
						<td class="text-center">${a.jam_masuk || '-'}</td>
						<td class="text-center">${a.jam_pulang || '-'}</td>
						<td class="text-center"><span class="badge ${statusBadge(a.status) ? 'data-variant='+JSON.stringify(statusBadge(a.status)) : ''}">${a.status || '-'}</span></td>
					</tr>
				`).join('');
			}

			function exportCSV() {
				const bln = document.getElementById('bulanPicker').value;
				const thn = document.getElementById('tahunPicker').value;
				window.location.href = '/api/admin/export-csv?bulan=' + bln + '&tahun=' + thn;
			}
		</script>
	}
}
