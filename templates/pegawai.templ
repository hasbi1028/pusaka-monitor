package templates

templ PegawaiPage() {
	@Layout("Pegawai", "", "") {
		@Sidebar("pegawai")
		<div class="main-content">
			@Topbar("Pegawai")
			<div class="content">
				<div class="card">
					<div class="table-container">
						<table class="table">
							<thead>
								<tr>
									<th>NIP</th>
									<th>Nama</th>
									<th class="text-center">Scrape</th>
									<th class="text-center">Aksi</th>
								</tr>
							</thead>
							<tbody id="pegawaiTable">
								<tr><td colspan="4" class="text-center text-muted-foreground py-4">Memuat data...</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		@BottomNav("pegawai")
		<!-- Modal (Basecoat native dialog) -->
		<dialog id="pegawaiModal" class="dialog" aria-labelledby="modalTitle" aria-describedby="modalDesc" onclick="if(event.target===this)this.close()">
			<div class="sm:max-w-sm">
				<header>
					<h2 id="modalTitle">Tambah Pegawai</h2>
					<p id="modalDesc" class="text-muted-foreground">Isi data pegawai dan password Pusaka.</p>
				</header>
				<section>
					<input type="hidden" id="editId"/>
					<div class="grid gap-2 mb-3">
						<label class="label">NIP <span class="text-destructive">*</span></label>
						<input type="text" class="input" id="nip" placeholder="Nomor Induk Pegawai" required/>
					</div>
					<div class="grid gap-2 mb-3">
						<label class="label">Nama Lengkap <span class="text-destructive">*</span></label>
						<input type="text" class="input" id="nama" required/>
					</div>
					<div class="grid gap-2 mb-1">
						<label class="label">Password Pusaka</label>
						<input type="password" class="input" id="password_pusaka" placeholder="Password login Pusaka Kemenag"/>
					</div>
				</section>
				<footer>
					<button class="btn" data-variant="ghost" onclick="document.getElementById('pegawaiModal').close()">Batal</button>
					<button class="btn" onclick="savePegawai()">Simpan</button>
				</footer>
				<button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Tutup" onclick="document.getElementById('pegawaiModal').close()"><i class="bi bi-x-lg"></i></button>
			</div>
		</dialog>
		<script>
			async function loadPegawai() {
				const res = await fetch('/api/pegawai');
				const data = await res.json();
				const tbody = document.getElementById('pegawaiTable');
				if (data.success && data.data.length > 0) {
					tbody.innerHTML = data.data.map(p => `
						<tr>
							<td><small class="text-muted-foreground">${p.nip}</small></td>
							<td>${p.nama}</td>
							<td class="text-center">
								<button class="btn" data-variant="outline" data-size="sm" onclick="scrapePegawai('${p.nip}')" title="Scrape 1 pegawai"><i class="bi bi-lightning-charge"></i></button>
							</td>
							<td class="text-center">
								<button class="btn" data-variant="outline" data-size="sm" onclick='editPegawai(${JSON.stringify(p)})'><i class="bi bi-pencil"></i></button>
								<button class="btn" data-variant="destructive" data-size="sm" onclick="deletePegawai('${p.id}')"><i class="bi bi-trash"></i></button>
							</td>
						</tr>
					`).join('');
				} else {
					tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted-foreground py-4">Belum ada pegawai</td></tr>';
				}
			}
			function showAddModal() {
				document.getElementById('modalTitle').textContent = 'Tambah Pegawai';
				document.getElementById('editId').value = '';
				document.getElementById('nip').value = '';
				document.getElementById('nama').value = '';
				document.getElementById('password_pusaka').value = '';
				document.getElementById('pegawaiModal').showModal();
			}
			function editPegawai(p) {
				document.getElementById('modalTitle').textContent = 'Edit Pegawai';
				document.getElementById('editId').value = p.id;
				document.getElementById('nip').value = p.nip;
				document.getElementById('nama').value = p.nama;
				document.getElementById('password_pusaka').value = '';
				document.getElementById('pegawaiModal').showModal();
			}
			async function savePegawai() {
				const id = document.getElementById('editId').value;
				const body = {
					nip: document.getElementById('nip').value,
					nama: document.getElementById('nama').value,
					password_pusaka: document.getElementById('password_pusaka').value
				};
				const url = id ? `/api/pegawai/${id}` : '/api/pegawai';
				const method = id ? 'PUT' : 'POST';
				const res = await fetch(url, { method, headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
				const data = await res.json();
				if (data.success) {
					document.getElementById('pegawaiModal').close();
					loadPegawai();
					showToast('Pegawai berhasil disimpan');
				}
			}
			async function deletePegawai(id) {
				if (!confirm('Nonaktifkan pegawai ini?')) return;
				await fetch(`/api/pegawai/${id}`, { method: 'DELETE' });
				loadPegawai();
				showToast('Pegawai dinonaktifkan', 'warning');
			}
			async function scrapePegawai(nip) {
				const res = await fetch(`/api/scrape/pegawai/${nip}`, { method: 'POST' });
				const d = await res.json();
				if (d.success) {
					showToast(d.message || 'Job scrape dibuat');
				} else {
					showToast(d.error || 'Gagal', 'danger');
				}
			}
			loadPegawai();
		</script>
	}
}
