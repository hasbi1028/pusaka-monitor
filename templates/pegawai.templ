package templates

templ PegawaiPage() {
	@Layout("Pegawai", "", "") {
		@Sidebar("pegawai")
		<div class="lg:pl-56 min-h-screen pb-20 lg:pb-0">
			@Topbar("Pegawai", "")
			<main class="p-4 page-enter">
				<!-- Action Bar -->
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-sm font-semibold text-gray-700"><i class="fa-solid fa-users mr-1"></i> Daftar Pegawai</h2>
					<button onclick="showAddModal()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">
						<i class="fa-solid fa-plus mr-1"></i>Tambah
					</button>
				</div>
				<!-- Table -->
				<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead class="bg-gray-50 text-gray-500 text-xs uppercase">
								<tr>
									<th class="px-4 py-2 text-left">NIP</th>
									<th class="px-4 py-2 text-left">Nama</th>
									<th class="px-4 py-2 text-center">Scrape</th>
									<th class="px-4 py-2 text-center">Aksi</th>
								</tr>
							</thead>
							<tbody id="pegawaiTable" class="divide-y divide-gray-100">
								<tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-sm">Memuat data...</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</main>
		</div>
		@BottomNav("pegawai")
		<!-- Modal -->
		<div id="pegawaiModal" class="fixed inset-0 z-50 hidden">
			<div class="absolute inset-0 bg-black/50" onclick="closePegawaiModal()"></div>
			<div class="absolute inset-0 flex items-center justify-center p-4">
				<div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 relative">
					<button onclick="closePegawaiModal()" class="absolute top-3 right-3 p-1 rounded-lg hover:bg-gray-100 text-gray-400">
						<i class="fa-solid fa-xmark"></i>
					</button>
					<h3 id="modalTitle" class="text-lg font-semibold text-gray-900 mb-1">Tambah Pegawai</h3>
					<p class="text-sm text-gray-500 mb-4">Isi data pegawai dan password Pusaka.</p>
					<input type="hidden" id="editId"/>
					<div class="space-y-3">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">NIP <span class="text-red-500">*</span></label>
							<input type="text" id="nip" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" placeholder="Nomor Induk Pegawai" required/>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap <span class="text-red-500">*</span></label>
							<input type="text" id="nama" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" required/>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Password Pusaka</label>
							<input type="password" id="password_pusaka" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" placeholder="Password login Pusaka Kemenag"/>
						</div>
					</div>
					<div class="flex gap-2 mt-6">
						<button onclick="closePegawaiModal()" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">Batal</button>
						<button onclick="savePegawai()" class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">Simpan</button>
					</div>
				</div>
			</div>
		</div>
		<script>
			function showAddModal() {
				document.getElementById('modalTitle').textContent = 'Tambah Pegawai';
				document.getElementById('editId').value = '';
				document.getElementById('nip').value = '';
				document.getElementById('nama').value = '';
				document.getElementById('password_pusaka').value = '';
				document.getElementById('pegawaiModal').classList.remove('hidden');
			}
			function closePegawaiModal() {
				document.getElementById('pegawaiModal').classList.add('hidden');
			}
			function editPegawai(p) {
				document.getElementById('modalTitle').textContent = 'Edit Pegawai';
				document.getElementById('editId').value = p.id;
				document.getElementById('nip').value = p.nip;
				document.getElementById('nama').value = p.nama;
				document.getElementById('password_pusaka').value = '';
				document.getElementById('pegawaiModal').classList.remove('hidden');
			}
			async function savePegawai() {
				const id = document.getElementById('editId').value;
				const body = {
					nip: document.getElementById('nip').value,
					nama: document.getElementById('nama').value,
					password_pusaka: document.getElementById('password_pusaka').value
				};
				const url = id ? `/api/pegawai/${id}` : '/api/pegawai';
				const method = id ? 'PUT' : 'POST';
				const res = await fetch(url, { method, headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
				const data = await res.json();
				if (data.success) { closePegawaiModal(); loadPegawai(); showToast('Pegawai berhasil disimpan'); }
			}
			async function deletePegawai(id) {
				if (!confirm('Nonaktifkan pegawai ini?')) return;
				await fetch(`/api/pegawai/${id}`, { method: 'DELETE' });
				loadPegawai();
				showToast('Pegawai dinonaktifkan', 'warning');
			}
			async function scrapePegawai(nip) {
				const res = await fetch(`/api/scrape/pegawai/${nip}`, { method: 'POST' });
				const d = await res.json();
				if (d.success) showToast(d.message || 'Job scrape dibuat');
				else showToast(d.error || 'Gagal', 'danger');
			}
			async function loadPegawai() {
				const res = await fetch('/api/pegawai');
				const data = await res.json();
				const tbody = document.getElementById('pegawaiTable');
				if (data.success && data.data.length > 0) {
					tbody.innerHTML = data.data.map(p => `<tr class="hover:bg-gray-50">
						<td class="px-4 py-2 text-gray-500 text-xs">${p.nip}</td>
						<td class="px-4 py-2 font-medium text-gray-900">${p.nama}</td>
						<td class="px-4 py-2 text-center">
							<button onclick="scrapePegawai('${p.nip}')" class="p-1.5 rounded-lg border border-gray-200 hover:bg-yellow-50 text-yellow-600 transition-colors" title="Scrape 1 pegawai"><i class="fa-solid fa-bolt text-sm"></i></button>
						</td>
						<td class="px-4 py-2 text-center">
							<div class="flex items-center justify-center gap-1">
								<button onclick='editPegawai(${JSON.stringify(p)})' class="p-1.5 rounded-lg border border-gray-200 hover:bg-blue-50 text-blue-600 transition-colors"><i class="fa-solid fa-pen text-sm"></i></button>
								<button onclick="deletePegawai('${p.id}')" class="p-1.5 rounded-lg border border-gray-200 hover:bg-red-50 text-red-600 transition-colors"><i class="fa-solid fa-trash text-sm"></i></button>
							</div>
						</td>
					</tr>`).join('');
				} else {
					tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-400 text-sm">Belum ada pegawai</td></tr>';
				}
			}
			loadPegawai();
		</script>
	}
}
