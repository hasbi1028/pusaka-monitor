package templates

templ PegawaiPage() {
	@Layout("Pegawai", "", "") {
		@Sidebar("pegawai")
		<div class="main-content">
			<header class="topbar">
				<div class="d-flex align-items-center gap-3">
					<button class="btn btn-sm btn-outline-secondary menu-btn" onclick="toggleSidebar()">
						<i class="bi bi-list"></i>
					</button>
					<span class="page-title">Pegawai</span>
				</div>
				<button class="btn btn-success btn-sm" onclick="showAddModal()">
					<i class="bi bi-plus-lg"></i> Tambah
				</button>
			</header>
			<div class="content">
				<div class="card">
					<div class="table-responsive">
						<table class="table table-hover">
							<thead>
								<tr>
									<th>NIP</th>
									<th>Nama</th>
									<th class="text-center">Scrape</th>
									<th class="text-center">Aksi</th>
								</tr>
							</thead>
							<tbody id="pegawaiTable">
								<tr><td colspan="3" class="text-center text-muted py-4">Memuat data...</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		@BottomNav("pegawai")
		<!-- Modal -->
		<div class="modal fade" id="pegawaiModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h6 class="modal-title" id="modalTitle">Tambah Pegawai</h6>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="editId"/>
						<div class="mb-3">
							<label class="form-label fw-semibold">NIP <span class="text-danger">*</span></label>
							<input type="text" class="form-control" id="nip" placeholder="Nomor Induk Pegawai" required/>
						</div>
						<div class="mb-3">
							<label class="form-label fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
							<input type="text" class="form-control" id="nama" required/>
						</div>
						<div class="mb-3">
							<label class="form-label fw-semibold">Password Pusaka</label>
							<input type="password" class="form-control" id="password_pusaka" placeholder="Password login Pusaka Kemenag"/>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
						<button type="button" class="btn btn-primary" onclick="savePegawai()">Simpan</button>
					</div>
				</div>
			</div>
		</div>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script>
			async function loadPegawai() {
				const res = await fetch('/api/pegawai');
				const data = await res.json();
				const tbody = document.getElementById('pegawaiTable');
				if (data.success && data.data.length > 0) {
					tbody.innerHTML = data.data.map(p => `
						<tr>
							<td><small class="text-muted">${p.nip}</small></td>
							<td>${p.nama}</td>
							<td class="text-center">
								<button class="btn btn-sm btn-outline-info" onclick="scrapePegawai('${p.nip}')" title="Scrape 1 pegawai"><i class="bi bi-lightning-charge"></i></button>
							</td>
							<td class="text-center">
								<button class="btn btn-sm btn-outline-primary me-1" onclick='editPegawai(${JSON.stringify(p)})'><i class="bi bi-pencil"></i></button>
								<button class="btn btn-sm btn-outline-danger" onclick="deletePegawai('${p.id}')"><i class="bi bi-trash"></i></button>
							</td>
						</tr>
					`).join('');
				} else {
					tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">Belum ada pegawai</td></tr>';
				}
			}
			function showAddModal() {
				document.getElementById('modalTitle').textContent = 'Tambah Pegawai';
				document.getElementById('editId').value = '';
				document.getElementById('nip').value = '';
				document.getElementById('nama').value = '';
				document.getElementById('password_pusaka').value = '';
				new bootstrap.Modal(document.getElementById('pegawaiModal')).show();
			}
			function editPegawai(p) {
				document.getElementById('modalTitle').textContent = 'Edit Pegawai';
				document.getElementById('editId').value = p.id;
				document.getElementById('nip').value = p.nip;
				document.getElementById('nama').value = p.nama;
				document.getElementById('password_pusaka').value = '';
				new bootstrap.Modal(document.getElementById('pegawaiModal')).show();
			}
			async function savePegawai() {
				const id = document.getElementById('editId').value;
				const body = {
					nip: document.getElementById('nip').value,
					nama: document.getElementById('nama').value,
					password_pusaka: document.getElementById('password_pusaka').value
				};
				const url = id ? `/api/pegawai/${id}` : '/api/pegawai';
				const method = id ? 'PUT' : 'POST';
				const res = await fetch(url, { method, headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
				const data = await res.json();
				if (data.success) {
					bootstrap.Modal.getInstance(document.getElementById('pegawaiModal')).hide();
					loadPegawai();
					showToast('Pegawai berhasil disimpan');
				}
			}
			async function deletePegawai(id) {
				if (!confirm('Nonaktifkan pegawai ini?')) return;
				await fetch(`/api/pegawai/${id}`, { method: 'DELETE' });
				loadPegawai();
				showToast('Pegawai dinonaktifkan', 'warning');
			}
			async function scrapePegawai(nip) {
				const res = await fetch(`/api/scrape/pegawai/${nip}`, { method: 'POST' });
				const d = await res.json();
				if (d.success) {
					showToast(d.message || 'Job scrape dibuat');
				} else {
					showToast(d.error || 'Gagal', 'danger');
				}
			}
			loadPegawai();
		</script>
	}
}
